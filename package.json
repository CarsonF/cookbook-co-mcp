{
  "name": "cookbook-co-mcp",
  "version": "0.2.0",
  "description": "Unofficial MCP server for CookBook Co.: recipes, tags, meal planner and shopping lists",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cookbook",
    "recipes",
    "meal-planner",
    "shopping-list"
  ],
  "homepage": "https://github.com/CarsonF/cookbook-co-mcp#readme",
  "bugs": "https://github.com/CarsonF/cookbook-co-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CarsonF/cookbook-co-mcp.git"
  },
  "license": "MIT",
  "author": "Carson Full <carson@full.family>",
  "type": "module",
  "bin": {
    "cookbook-mcp": "dist/cookbook-mcp.js"
  },
  "files": [
    "dist/cookbook-mcp.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --loader:.ttf=base64 --define:__VERSION__='\"'$npm_package_version'\"' --outfile=dist/cookbook-mcp.js",
    "test": "pnpm bundle && node --test \"test/**/*.test.ts\"",
    "prepack": "pnpm bundle"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "firebase": "^13.2.0",
    "got": "^16.2.0",
    "ms": "^2.1.3",
    "pdfmake": "0.2.20",
    "remeda": "^2.57.0",
    "title-case": "^4.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ms": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/pdfmake": "^0.2.13",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  }
}
